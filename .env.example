# Required to use the research API. Keep all values server-side.
MISTRAL_API_KEY=
# Optional: defaults to mistral-small-latest (low cost, reliable tool calling)
MISTRAL_MODEL=mistral-small-latest

# Required to protect the single-user app. Use a long random app password
# and a separate random signing secret of at least 32 characters.
APP_ACCESS_PASSWORD=
SESSION_SECRET=

# Optional: pre-configure the invited vedic.study account so the app does not
# ask for it. If left empty, the app asks for the email and password after you
# sign in. (Not available for Google/Apple-only accounts.)
VEDIC_STUDY_EMAIL=
VEDIC_STUDY_PASSWORD=

# Optional safety ceilings. Research has no fixed step limit; these only stop runaways.
# RESEARCH_MAX_STEPS=
# RESEARCH_MAX_MINUTES=60

# Alternative to the above: path on the server to a Playwright storage-state JSON file
# created from an account you are authorized to use. Never commit this file.
VEDIC_STUDY_STORAGE_STATE_PATH=.auth/vedic-study.json
# Optional JSON object for sessionStorage values, configured as a server secret.
VEDIC_STUDY_SESSION_STORAGE_JSON=
# Optional site search URL template; {query} is URL-encoded before navigation.
VEDIC_SEARCH_URL_TEMPLATE=https://vedic.study/search?q={query}
