# Required to use the research API. Keep all values server-side.
ANTHROPIC_API_KEY=
# Optional: defaults to claude-sonnet-4-20250514
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Required to protect the single-user app. Use a long random app password
# and a separate random signing secret of at least 32 characters.
APP_ACCESS_PASSWORD=
SESSION_SECRET=

# Optional: path on the server to a Playwright storage-state JSON file
# created from an account you are authorized to use. Never commit this file.
VEDIC_STUDY_STORAGE_STATE_PATH=.auth/vedic-study.json
# Optional JSON object for sessionStorage values, configured as a server secret.
VEDIC_STUDY_SESSION_STORAGE_JSON=
# Optional site search URL template; {query} is URL-encoded before navigation.
VEDIC_SEARCH_URL_TEMPLATE=https://vedic.study/search?q={query}
